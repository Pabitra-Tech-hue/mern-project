{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./builds",
    "module": "commonjs",
    "target": "es2022",
    "types": ["node"],
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}

